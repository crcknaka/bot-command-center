# Server port
PORT=3000

# First start only: the admin account to create. Without ADMIN_PASSWORD a random
# one-time password is printed to the log.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# Docker: address the panel listens on. 127.0.0.1 = only through a reverse proxy on this host.
BIND_ADDR=0.0.0.0

# Only if the UI is served from another origin than the API (comma-separated). Empty = same origin.
CORS_ORIGIN=
